# 复制为 .env 后填写
AUTH_USER=admin
AUTH_PASSWORD=换成你的密码
# 模型 API key（dsh settings.yaml 里 apiKeyEnv 声明的变量）
# XIN_API_KEY=sk-xxxx
# 模型网关走代理时设置（Clash 需开启"允许局域网连接"，端口按实际改）
# HTTP_PROXY=http://172.19.0.1:7890
# HTTPS_PROXY=http://172.19.0.1:7890
# 公网域名访问时必填：dsh web 的 /api 只信任 loopback 和这里声明的来源
# （空格分隔多个域名，如 "dsh.example.com"）
# TRUSTED_HOSTS=
# 国内网络可取消注释使用镜像源
# NPM_REGISTRY=https://registry.npmmirror.com
